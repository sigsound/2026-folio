---
export interface Props {
  title?: string;
  description?: string;
  heroHeader?: boolean;
}

const {
  title = "nickwoods.us",
  description = "Nick Woods is a digital product design leader, motion artist, and strategist",
  heroHeader = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Blocking theme init: must run before first paint to prevent flash -->
    <script is:inline>
      (function() {
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (window.matchMedia('(prefers-color-scheme)').media !== 'not all') {
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        } else {
          var hour = new Date().getHours();
          document.documentElement.setAttribute('data-theme', (hour >= 18 || hour < 6) ? 'dark' : 'light');
        }
      })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400..900&family=Lato:wght@400;700&display=swap" rel="stylesheet">

    <!-- Global Styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div id="theme-provider">
      <header class="Header">
        <div class="HeaderGroup">
          <a class="Logo" href="/">
            <img id="logo-img" src={heroHeader ? '/images/Logo-on-Dark.svg' : '/images/Logo-on-Light.svg'} alt="An iconographic representation of Nick Woods" width="48" />
          </a>
        </div>
      </header>

      <div class="layout-content">
        <main>
          <slot />
        </main>
      </div>
    </div>

    <script define:vars={{ heroHeader }}>
      // Set correct initial logo on non-hero pages (hero pages always use white logo, set server-side)
      if (!heroHeader) {
        const theme = document.documentElement.getAttribute('data-theme');
        const logoImg = document.getElementById('logo-img');
        if (logoImg) {
          logoImg.src = theme === 'dark' ? '/images/Logo-on-Dark.svg' : '/images/Logo-on-Light.svg';
        }
      }

      // Always listen for OS theme changes so the page theme stays in sync on ALL pages
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        const newTheme = e.matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        // Only swap the logo on non-hero pages (hero pages always keep white logo)
        if (!heroHeader) {
          const logo = document.getElementById('logo-img');
          if (logo) logo.src = newTheme === 'dark' ? '/images/Logo-on-Dark.svg' : '/images/Logo-on-Light.svg';
        }
      });
    </script>
  </body>
</html>
