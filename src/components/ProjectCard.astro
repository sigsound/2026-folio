---
export interface Props {
  title: string;
  credits?: string;
  image: string;
  contentfulId: string;
}

const { title, credits, image, contentfulId } = Astro.props;
---

<div class="Card">
  <a href={`/case-studies/${contentfulId}`} class="CardLink">
    <div class="CardImage" style={`background-image: url(${image})`}>
      <!-- Desktop hover overlay -->
      <div class="CardOverlay">
        <h3 class="CardOverlayTitle">{title}</h3>
        {credits && <p class="CardOverlayCredits">{credits}</p>}
      </div>
    </div>
    <!-- Mobile always-visible caption -->
    <div class="CardCaption">
      <h3 class="CardCaptionTitle">{title}</h3>
      {credits && <p class="CardCaptionCredits">{credits}</p>}
    </div>
  </a>
</div>

<style>
  .Card {
    display: flex;
    flex-direction: column;
  }

  .CardLink {
    display: flex;
    flex-direction: column;
    border-bottom: none;
  }

  .CardLink:hover {
    border-bottom: none;
  }

  .CardImage {
    background-size: cover;
    background-position: center;
    width: 100%;
    height: 390px;
    position: relative;
    border-radius: 24px;
    /* overflow: hidden removed — CSS background respects border-radius natively */
  }

  /* Desktop: overlay hidden by default, revealed on hover */
  .CardOverlay {
    position: absolute;
    inset: 0;
    border-radius: 16px; /* explicit since parent has no overflow:hidden */
    background-color: var(--card-bg);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
    margin: 16px;
    transition: opacity 0.3s ease;
  }

  .CardLink:hover .CardOverlay {
    opacity: 0.94;
  }

  .CardOverlayTitle {
    font-family: 'Bodoni Moda', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .CardOverlayCredits {
  font-family: 'Lato', sans-serif;
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Mobile caption: hidden on desktop, shown on mobile */
  .CardCaption {
    display: none;
    padding: 12px 0 4px;
  }

  .CardCaptionTitle {
    font-family: 'Bodoni Moda', serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .CardCaptionCredits {
  font-family: 'Lato', sans-serif;
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 1023px) {
    .CardImage { height: 260px; }
    .CardOverlay { display: none; }
    .CardCaption { display: block; }
  }
</style>
