---
export interface Props {
  title: string;
  role?: string;
  image: string;
  contentfulId: string;
  extra?: boolean;
}

const { title, role, image, contentfulId, extra = false } = Astro.props;
---

<div class:list={["Card", "reveal", { "is-extra": extra }]}>
  <a href={`/case-studies/${contentfulId}`} class="CardLink">
    <div class="CardImage" style={`--card-img: url(${image})`}>
      <!-- Desktop hover overlay -->
      <div class="CardOverlay">
        <h3 class="CardOverlayTitle">{title}</h3>
        {role && <p class="CardOverlayRole">{role}</p>}
      </div>
    </div>
    <!-- Mobile always-visible caption -->
    <div class="CardCaption">
      <h3 class="CardCaptionTitle">{title}</h3>
      {role && <p class="CardCaptionRole">{role}</p>}
    </div>
  </a>
</div>

<style>
  .Card {
    display: flex;
    flex-direction: column;
  }

  .CardLink {
    display: flex;
    flex-direction: column;
    border-bottom: none;
    background-image: none;
  }

  .CardLink:hover {
    border-bottom: none;
  }

  .CardImage {
    position: relative;
    width: 100%;
    height: 390px;
    border-radius: 24px;
    overflow: hidden; /* clip the hover zoom */
  }

  /* Image lives on a pseudo-element so it can scale without moving the overlay/caption */
  .CardImage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--card-img);
    background-size: cover;
    background-position: center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .CardLink:hover .CardImage::before {
      transform: scale(1.04);
    }
  }

  /* Desktop: overlay hidden by default, revealed on hover.
     Frosted glass keeps the zoomed image visible but blurred, so text stays legible. */
  .CardOverlay {
    position: absolute;
    inset: 0;
    z-index: 1; /* above the image pseudo-element */
    border-radius: 16px;
    background-color: var(--card-bg); /* solid fallback if backdrop-filter is unsupported */
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
    margin: 16px;
    transition: opacity 0.3s ease;
  }

  @supports ((-webkit-backdrop-filter: blur(14px)) or (backdrop-filter: blur(14px))) {
    .CardOverlay {
      background-color: color-mix(in srgb, var(--card-bg) 80%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(120%);
      backdrop-filter: blur(14px) saturate(120%);
    }
  }

  .CardLink:hover .CardOverlay {
    opacity: 1;
  }

  .CardOverlayTitle {
    font-family: 'Bodoni Moda', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .CardOverlayRole {
    font-family: 'Lato', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Mobile caption: hidden on desktop, shown on mobile */
  .CardCaption {
    display: none;
    padding: 12px 0 4px;
  }

  .CardCaptionTitle {
    font-family: 'Bodoni Moda', serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .CardCaptionRole {
    font-family: 'Lato', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 1023px) {
    .CardImage { height: 260px; }
    .CardOverlay { display: none; }
    .CardCaption { display: block; }
  }
</style>
