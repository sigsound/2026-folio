---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MinimalistHero from '../components/MinimalistHero.astro';

// Get projects and sort by order (if available) or by title
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => {
  // Sort by explicit `order`; projects without one fall to the end (alphabetical)
  const ao = a.data.order ?? Infinity;
  const bo = b.data.order ?? Infinity;
  if (ao !== bo) return ao - bo;
  return (a.data.title || '').localeCompare(b.data.title || '');
});

// Get about content
const aboutCollection = await getCollection('about');
const about = aboutCollection[0]; // Should be one about entry
const { Content: AboutContent } = about ? await render(about) : { Content: null };
---

<Base title="nickwoods.us - Product Design Leader">
  <MinimalistHero />

  <div class="Hero">
    <div class="HeroGroup reveal">
      <h1>Designing the forest
        <br>and the trees</h1>
    </div>
  </div>

  <div class="Cards col" id="project-grid">
    {sortedProjects.map((project, index) => (
      <ProjectCard
        title={project.data.title}
        role={project.data.role}
        image={project.data.thumbnail}
        contentfulId={project.slug}
        extra={index >= 4}
      />
    ))}

    {sortedProjects.length > 4 && (
      <div class="more-row">
        <button id="more-btn" class="more-btn" type="button" aria-controls="project-grid" aria-expanded="false">
          View all work
          <svg class="more-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    )}
  </div>

  {about && (
    <div class="cs-content">
      <div class="about reveal">
        <div class="about-img" style={`background-image: url(${about.data.profileImage})`}></div>
        <div class="about-text">
          {AboutContent && <AboutContent />}
        </div>
      </div>
    </div>
  )}

  <div class="skills-footer">
    <div class="reveal">
      <h3>Core Skills</h3>
