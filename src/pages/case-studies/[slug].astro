---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

function getVimeoEmbedUrl(url: string): string | null {
  if (!url) return null;
  if (url.includes('player.vimeo.com')) return url;
  const match = url.match(/vimeo\.com\/(?:.*\/)?(?:video\/)?(?:vi=)?(\d+)/);
  if (match) return `https://player.vimeo.com/video/${match[1]}?title=0&byline=0&portrait=0`;
  if (/^\d+$/.test(url.trim())) return `https://player.vimeo.com/video/${url.trim()}?title=0&byline=0&portrait=0`;
  return null;
}

const videoEmbeds = (project.data.videos ?? []).map(getVimeoEmbedUrl).filter(Boolean);
---

<Base title={`${project.data.title} - Nick Woods`} description={project.data.impact} heroHeader={true}>

  <!-- Full-bleed header: thumbnail placeholder behind an 80% scrim (swap for a dedicated header image later) -->
  <div class="cs-hero-img" style={`background-image: url(${project.data.thumbnail})`}>
    <div class="cs-hero-overlay reveal">
      <h1 class="cs-title">{project.data.title}</h1>
      <div class="cs-metadata">
        <div class="cs-metadata-column">
          <h3>Role</h3>
          <p>{project.data.role}</p>
        </div>
        <div class="cs-metadata-column">
          <h3>Timeline</h3>
          <p>{project.data.timeline}</p>
        </div>
        <div class="cs-metadata-column">
          <h3>Impact</h3>
          <p>{project.data.impact}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Single centered column -->
  <div class="cs-single-col">

    <!-- Body copy -->
    <div class="cs-body reveal">
      <Content />
    </div>

    <!-- Hero image now shown as first featured image -->
    {project.data.hero && (
      <img class="cs-featured-img img-fade" src={project.data.hero} alt="" loading="lazy" decoding="async" />
    )}

    <!-- Secondary featured image (hisImage) -->
    {project.data.hisImage && (
      <img class="cs-featured-img img-fade" src={project.data.hisImage} alt="" loading="lazy" decoding="async" />
    )}

    <!-- Media grid -->
    {project.data.media && project.data.media.length > 0 && (
      <div class="cs-media-grid">
        {project.data.media.map((item) => (
          <img class="img-fade" src={item.src} alt={item.alt} loading="lazy" decoding="async" />
        ))}
      </div>
    )}

    <!-- Videos -->
    {videoEmbeds.length > 0 && (
      <div class="cs-videos">
        {videoEmbeds.map((embedUrl) => (
          <div class="video-wrapper reveal">
            <iframe
              src={embedUrl}
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
              title="Project video"
            />
          </div>
        ))}
      </div>
    )}

  </div>
</Base>
